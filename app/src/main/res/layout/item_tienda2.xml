<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivTienda2"
        style="@style/bkg_white_border_rounded_transparent"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/iv_placeholder" />

    <TextView
        android:id="@+id/tvHorarioTiendaItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bkg_white_border_rounded_transparent"
        android:elevation="5dp"
        android:text="Horario"
        android:textAlignment="center"
        android:textColor="#000000"
        app:layout_constraintEnd_toEndOf="@+id/ivTienda2"
        app:layout_constraintStart_toStartOf="@+id/ivTienda2"
        app:layout_constraintTop_toBottomOf="@+id/tvNombreTiendaItem" />

    <TextView
        android:id="@+id/tvNombreTiendaItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bkg_white_border_rounded_transparent"
        android:elevation="5dp"
        android:text="@string/title_tiendas"
        android:textAlignment="center"
        android:textColor="#000000"
        app:layout_constraintEnd_toEndOf="@+id/ivTienda2"
        app:layout_constraintStart_toStartOf="@+id/ivTienda2"
        app:layout_constraintTop_toBottomOf="@+id/ivTienda2" />
</androidx.constraintlayout.widget.ConstraintLayout>