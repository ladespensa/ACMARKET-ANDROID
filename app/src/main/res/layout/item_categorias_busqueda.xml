<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/ivCategoriaItemBusqueda"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/iv_placeholder" />

    <TextView
        android:id="@+id/tvTitleItemCategoriaBusqueda"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="TextView"
        android:textColor="@color/white"
        android:textSize="10dp"
        android:background="@color/gray_light_transparent"
        app:layout_constraintBottom_toBottomOf="@+id/ivCategoriaItemBusqueda"
        app:layout_constraintEnd_toEndOf="@+id/ivCategoriaItemBusqueda"
        app:layout_constraintStart_toStartOf="@+id/ivCategoriaItemBusqueda"
        app:layout_constraintTop_toTopOf="@+id/ivCategoriaItemBusqueda" />
</androidx.constraintlayout.widget.ConstraintLayout>